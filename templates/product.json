    "custom_liquid_yFkLzH": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Pet Product Reviews Slider</title>\n    <!-- Swiper CSS -->\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/swiper/swiper-bundle.min.css\">\n    <style>\n        body {\n            background-color: #B0EACD; /* Dark background for better contrast */\n            font-family: Arial, sans-serif;\n        }\n\n        #card-container {\n            width: 100%;\n            margin: 0 auto;\n            overflow: hidden;\n            position: relative;\n            padding: 20px 0;\n        }\n\n        .swiper-container {\n            width: calc(100% - 20px);\n            position: relative;\n            margin: 0 auto;\n            padding: 10px 0px;\n        }\n\n        @keyframes upAndDown {\n            0%, 100% { transform: translateY(0); }\n            25% { transform: translateY(-4px); }\n            50% { transform: translateY(0px); }\n            75% { transform: translateY(4px); }\n        }\n\n        @keyframes downAndUp {\n            0%, 100% { transform: translateY(0); }\n            25% { transform: translateY(4px); }\n            50% { transform: translateY(0px); }\n            75% { transform: translateY(-4px); }\n        }\n\n        .swiper-slide:nth-child(odd) {\n            animation: upAndDown 4s infinite linear;\n        }\n\n        .swiper-slide:nth-child(even) {\n            animation: downAndUp 4s infinite linear;\n        }\n\n        .swiper-slide {\n            max-width: 280px;\n            height: 230px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            background: #FFF7EB;\n            border: 2px solid rgba(255, 255, 255, 0.15);\n            border-radius: 8px;\n            padding: 12px;\n            box-sizing: border-box;\n            justify-content: space-between;\n            gap: 15px;\n            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);\n        }\n\n        .rating {\n            font-size: 32px;\n            color: #FFC75F;\n            margin-top: 5px;\n            line-height: 20px;\n        }\n\n        .description {\n            font-size: 14px;\n            color: #2B2B2B;\n            text-align: center;\n            line-height: 22px;\n        }\n\n        .name {\n            color: #2B2B2B;\n            font-weight: bold;\n            display: flex;\n            align-items: center;\n            gap: 5px;\n        }\n\n        .swiper-button-prev, .swiper-button-next {\n            color: white;\n            font-size: 15px !important;\n            background-color: #333;\n            width: 30px;\n            height: 30px;\n            border-radius: 50%;\n            margin: 0 10px;\n            top: 42% !important;\n        }\n\n        @media (max-width: 767px) {\n            .swiper-button-prev, .swiper-button-next {\n                display: none;\n            }\n        }\n\n        .swiper-pagination {\n            position: relative;\n            margin-top: 30px;\n            display: flex;\n            justify-content: center;\n        }\n\n        .swiper-pagination-bullet {\n            width: 2.5rem;\n            height: 0.5rem;\n            background-color: #0d437d;\n            border-radius: 0px;\n            cursor: pointer;\n        }\n\n        .swiper-pagination-bullet-active {\n            width: 3rem;\n            background-image: linear-gradient(45deg, #1cbcc3, #4abf8f 80%);\n            border-radius: 4px;\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"container\">\n    <div id=\"card-container\">\n        <div class=\"swiper-container\">\n            <div class=\"swiper-wrapper\">\n                <!-- Review 1 -->\n                <div class=\"swiper-slide\">\n                    <div class=\"rating\">★★★★★</div>\n                    <div class=\"description\">\"My dog absolutely loves this bed! It's so soft and cozy—he never wants to leave it!\"</div>\n                    <div class=\"name\"> <strong>Jessica M</strong> <img src=\"https://cdn3.emoji.gg/emojis/9796-verified.png\" width=\"20px\" alt=\"Verified\"> <span>Verified</span></div>\n                </div>\n                \n                <!-- Review 2 -->\n                <div class=\"swiper-slide\">\n                    <div class=\"rating\">★★★★★</div>\n                    <div class=\"description\">\"This harness is a game-changer! No more pulling, and my pup seems so comfortable in it!\"</div>\n                    <div class=\"name\"> <strong>Emily R</strong> <img src=\"https://cdn3.emoji.gg/emojis/9796-verified.png\" width=\"20px\" alt=\"Verified\"> <span>Verified</span></div>\n                </div>\n\n                <!-- Review 3 -->\n                <div class=\"swiper-slide\">\n                    <div class=\"rating\">★★★★★</div>\n                    <div class=\"description\">\"Best chew toy ever! My dog usually destroys toys in minutes, but this one has lasted weeks!\"</div>\n                    <div class=\"name\"> <strong>Lucas T</strong> <img src=\"https://cdn3.emoji.gg/emojis/9796-verified.png\" width=\"20px\" alt=\"Verified\"> <span>Verified</span></div>\n                </div>\n\n                <!-- Review 4 -->\n                <div class=\"swiper-slide\">\n                    <div class=\"rating\">★★★★★</div>\n                    <div class=\"description\">\"I love this cat tree! My kitty spends hours playing and lounging on it—such great quality!\"</div>\n                    <div class=\"name\"> <strong>Sarah H</strong> <img src=\"https://cdn3.emoji.gg/emojis/9796-verified.png\" width=\"20px\" alt=\"Verified\"> <span>Verified</span></div>\n                </div>\n\n                <!-- Review 5 -->\n                <div class=\"swiper-slide\">\n                    <div class=\"rating\">★★★★★</div>\n                    <div class=\"description\">\"This water fountain keeps my cat hydrated all day! He loves the fresh flowing water!\"</div>\n                    <div class=\"name\"> <strong>Amanda W</strong> <img src=\"https://cdn3.emoji.gg/emojis/9796-verified.png\" width=\"20px\" alt=\"Verified\"> <span>Verified</span></div>\n                </div>\n\n                <!-- Review 6 -->\n                <div class=\"swiper-slide\">\n                    <div class=\"rating\">★★★★★</div>\n                    <div class=\"description\">\"The best dog shampoo ever! My pup smells amazing, and his coat is so soft and shiny!\"</div>\n                    <div class=\"name\"> <strong>Olivia M</strong> <img src=\"https://cdn3.emoji.gg/emojis/9796-verified.png\" width=\"20px\" alt=\"Verified\"> <span>Verified</span></div>\n                </div>\n            </div>\n        </div> \n\n        <div class=\"swiper-button-prev\"></div>\n        <div class=\"swiper-button-next\"></div>\n        <div class=\"swiper-pagination\"></div>\n    </div>\n</div>\n\n<script src=\"https://unpkg.com/swiper/swiper-bundle.min.js\"></script>\n<script>\n    new Swiper('.swiper-container', {\n        slidesPerView: 'auto',\n        spaceBetween: 10,\n        navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },\n        pagination: { el: '.swiper-pagination', clickable: true },\n        autoplay: { delay: 10000, disableOnInteraction: false }\n    });\n</script>\n\n</body>\n</html>",

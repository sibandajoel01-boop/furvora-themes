      "settings": {
        "custom_liquid": "<div class=\"containerv8 product_tab_sec\">\n  <div class=\"inner-container\">\n    <div class=\"header-text\">\n      A New Era of Pet Comfort & Happiness!\n    </div>\n    <p>Designed with love, crafted for wagging tails\u2014where innovation meets cuddles!</p>\n\n\n\n    <div class=\"golden-capsule-three-col\">\n      <div class=\"item-headings\">\n        \n          <div class=\"items active\">\n            <div>\n              <img src=\"https://cdn.shopify.com/s/files/1/0615/0019/4925/files/Untitled_design_2_1.png?v=1739771231?\">\n              <span class=\"feature_desk_heading\"> Ultra-Soft & Pet-Safe Materials</span>\n            </div>\n            <span class=\"feature_mob_heading\"></span>\n          </div>\n        \n          <div class=\"items \">\n            <div>\n              <img src=\"https://cdn.shopify.com/s/files/1/0615/0019/4925/files/Untitled_design_2_1.png?v=1739771231\">\n              <span class=\"feature_desk_heading\">Soothe with Smart Sounds</span>\n            </div>\n            <span class=\"feature_mob_heading\"></span>\n          </div>\n        \n          <div class=\"items \">\n            <div>\n              <img src=\"https://cdn.shopify.com/s/files/1/0615/0019/4925/files/Untitled_design_2_1.png?v=1739771231\">\n              <span class=\"feature_desk_heading\">Parent-Friendly, Pet-Approved</span>\n            </div>\n            <span class=\"feature_mob_heading\"></span>\n          </div>\n        \n          <div class=\"items \">\n            <div>\n              <img src=\"https://cdn.shopify.com/s/files/1/0615/0019/4925/files/Untitled_design_2_1.png?v=1739771231\">\n              <span class=\"feature_desk_heading\">Adorable & Functional Designs</span>\n            </div>\n            <span class=\"feature_mob_heading\"></span>\n          </div>\n        \n      </div>\n      <div class=\"img_container\">\n        \n          <div class=\"capsule-img active\">\n            \n\n            \n              \n                <video-component data-autoplay=\"true\" data-background=\"true\">\n                  <video playsinline=\"true\" class=\"\" autoplay=\"autoplay\" muted=\"muted\" loop=\"loop\" preload=\"metadata\"><source src=\"https://cdn.shopify.com/videos/c/o/v/1ef3c79e69254132bad70fe2014aee1d.mp4?v=0\" type=\"video/mp4\"><img loading=\"lazy\" hidden=\"\" src=\"//www.moonpod.co/cdn/shop/files/preview_images/5bdcdfe3eb454c0baf9fa624443cf5b9.thumbnail.0000000000_small.jpg?v=1734131486\"></video>\n                </video-component>\n              \n            \n          </div>\n        \n          <div class=\"capsule-img \">\n            \n\n            \n              \n                <video-component data-autoplay=\"true\" data-background=\"true\">\n                  <video playsinline=\"true\" class=\"\" autoplay=\"autoplay\" muted=\"muted\" loop=\"loop\" preload=\"metadata\"><source src=\"https://cdn.shopify.com/videos/c/o/v/2e311cee0a5d42d4a4eb6ba67d8fb45f.mp4?v=0\" type=\"video/mp4\"><img loading=\"lazy\" hidden=\"\" src=\"//www.moonpod.co/cdn/shop/files/preview_images/8652dcfb4ca34bfdb7a55bdc0821f91f.thumbnail.0000000000_small.jpg?v=1734131541\"></video>\n                </video-component>\n              \n            \n          </div>\n        \n          <div class=\"capsule-img \">\n            \n\n            \n              \n                <video-component data-autoplay=\"true\" data-background=\"true\">\n                  <video playsinline=\"true\" class=\"\" autoplay=\"autoplay\" muted=\"muted\" loop=\"loop\" preload=\"metadata\"><source src=\"https://cdn.shopify.com/videos/c/o/v/7eeef59a8be949aab7a0335ae45ad28d.mp4?v=0\" type=\"video/mp4\"><img loading=\"lazy\" hidden=\"\" src=\"//www.moonpod.co/cdn/shop/files/preview_images/913ce214c9074afaacb3fbd9596deb1e.thumbnail.0000000000_small.jpg?v=1734131592\"></video>\n                </video-component>\n              \n            \n          </div>\n        \n          <div class=\"capsule-img \">\n            \n\n            \n              \n                <video-component data-autoplay=\"true\" data-background=\"true\">\n                  <video playsinline=\"true\" class=\"\" autoplay=\"autoplay\" muted=\"muted\" loop=\"loop\" preload=\"metadata\"><source src=\"https://cdn.shopify.com/videos/c/o/v/b4988da576874af398936b797d9bec5e.mp4?v=0\" type=\"video/mp4\"><img loading=\"lazy\" hidden=\"\" src=\"//www.moonpod.co/cdn/shop/files/preview_images/9a4367a1cef244299da97841f9bd75da.thumbnail.0000000000_small.jpg?v=1734131666\"></video>\n                </video-component>\n              \n            \n          </div>\n        \n      </div>\n      <div class=\"text-container\">\n       \n          <div class=\"desc-tab active\">\n            <div class=\"desc-heading\">The Softest Touch, The Smartest Designs</div>\n            <div class=\"desc-para\"><p>Gentle on paws, tough on messes!</p></div>\n          </div>\n        \n          <div class=\"desc-tab \">\n            <div class=\"desc-heading\">Soothing Sounds for a Relaxed Pet</div>\n            <div class=\"desc-para\"><p>White noise, calming music & heartbeat rhythms to ease anxiety!</p></div>\n          </div>\n        \n          <div class=\"desc-tab \">\n            <div class=\"desc-heading\">Designed to Make Pet Care Effortless</div>\n            <div class=\"desc-para\"><p>Smart solutions for happier pets & stress-free pet parents!</p></div>\n          </div>\n        \n          <div class=\"desc-tab \">\n            <div class=\"desc-heading\">Perfect for Snuggles & Playtime Adventures</div>\n            <div class=\"desc-para\"><p>Because pet products should be as fun as they are functional!</p></div>\n          </div>\n        \n      </div>\n    </div>\n  </div>\n</div>\n\n\n<style data-shopify=\"\">\n  /* Add Orbitron font */\n  @font-face {\n      font-family: 'CustomBaloo';\n      src: url('https://cdn.shopify.com/s/files/1/0615/0019/4925/files/Baloo2-VariableFont_wght.ttf?v=1740370360') format('truetype');\n  }\n\n  /* Apply Orbitron font and set all text colors to black */\n  .product_tab_sec .header-text {\n      font-family: 'CustomBaloo', sans-serif !important;\n      font-size: 56px; /* Adjust font size */\n      font-weight: 700; /* Adjust weight for header */\n      line-height: 58px; /* Adjust line height */\n      color: #2B2B2B; /* Black color */\n      text-align: center;\n      margin-bottom: 12px;\n  }\n\n  .product_tab_sec .feature_desk_heading {\n      font-family: 'CustomBaloo', sans-serif !important;\n      font-size: 24px;\n      font-weight: 700;\n      line-height: 30px;\n      color: #2B2B2B; /* Black color */\n  }\n\n  .product_tab_sec .item-headings div.active span {\n      font-family: 'CustomBaloo', sans-serif !important;\n      font-size: 30px;\n      font-weight: 800;\n      line-height: 40px;\n      color: #2B2B2B; /* Black color */\n  }\n\n  .product_tab_sec p {\n      color: #2B2B2B; /* Black color */\n      font-size: 18px;\n      font-family: sans-serif !important; /* Default font for paragraphs */\n      font-weight: 400;\n      line-height: normal;\n      text-align: center;\n  }\n\n  .product_tab_sec .desc-tab .desc-heading {\n      color: #2B2B2B; /* Black color */\n      font-family: 'CustomBaloo', sans-serif !important;\n      font-size: 24px; /* Adjust font size for headings in description */\n      font-weight: 700;\n      line-height: 26px;\n  }\n\n  /* Keep the rest of your existing styles as is */\n  .category_product_item .card--product .card__media-main-img img, .category_product_item .card--product .card__hover-image img {\n      object-fit: contain;\n  }\n</style>\n\n<script>\n  var itemHeadings = document.querySelectorAll('.golden-capsule-three-col .item-headings>div');\n  var textContainers = document.querySelectorAll('.golden-capsule-three-col .text-container div.desc-tab');\n  var imgContainers = document.querySelectorAll('.golden-capsule-three-col .img_container .capsule-img');\n\n  itemHeadings.forEach((heading, index) => {\n    heading.addEventListener('click', () => {\n      itemHeadings.forEach((item) => item.classList.remove('active'));\n      textContainers.forEach((item) => item.classList.remove('active'));\n      imgContainers.forEach((item) => item.classList.remove('active'));\n\n      heading.classList.add('active');\n      imgContainers[index].classList.add('active');\n      textContainers[index].classList.add('active');\n    });\n  });\n</script>\n\n\n<style data-shopify=\"\">\n   .category_product_item .card--product .card__media-main-img img, .category_product_item .card--product .card__hover-image img{\n      object-fit: contain;\n   }\n    .immy-capsule{\n  background: #F5F8FF;\n  }\n    @media(min-width:768px){\n\n\n    .product_tab_sec{\n            padding-bottom: 52px !important;\n    }\n       }\n    .product_tab_sec .item-headings .items{\n      display: flex;\n      gap: 8px;\n  }\n    .product_tab_sec .item-headings .items>div{\n      display: flex;\n      align-items: center;\n      gap: 10px;\n  }\n    .product_tab_sec .inner-containerv8 {\n      margin: auto;\n      display: flex;\n      flex-direction: column;\n      gap: 70px;\n  }\n    .containerv8 .img_container{\n          flex: 37%;\n    }\n\n  .product_tab_sec .header-text {\n      color: var(--soil-1, ##2B2B2B);\n      text-align: justify;\n      font-size: 48px;\n      font-style: normal;\n      font-weight: 900;\n      line-height: 48px;\n    margin-bottom:12px;\n  }\n\n  .golden-capsule-three-col {\n      display: flex;\n      align-items: center;\n      gap: 4%;\n  }\n\n  .golden-capsule-three-col .item-headings {\n      flex: 35%;\n  }\n\n  .golden-capsule-three-col .capsule-img {\n      flex: 20%;\n  }\n\n\n  .golden-capsule-three-col .text-container {\n      flex: 35%;\n      padding-left: 5%;\n  }\n\n  .capsule-img {\n      max-height: 409px;\n  }\n\n  .capsule-img img {\n      height: 100%;\n      width: 100%;\n  }\n\n    .product_tab_sec video{\n      max-width: 450px;\n      min-height: 400px;\n      object-fit: cover;\n      border-radius: 25px;\n    }\n\n  .desc-tab {\n      display: none;\n  }\n\n  .desc-tab.active {\n      display: block;\n  }\n\n  .product_tab_sec .item-headings {\n      display: flex;\n      flex-direction: column;\n      gap: 48px;\n  }\n\n  .product_tab_sec .item-headings div span {\n        cursor: pointer;\n      color: var(--Brand-Purple, #2B2B2B);\n      font-size: 24px;\n      font-style: normal;\n      font-weight: 700;\n      line-height: 40px;\n  }\n\n  .product_tab_sec .item-headings div.active span {\n        color: #2B2B2B;\n      font-size: 30px;\n      font-style: normal;\n      font-weight: 800;\n      line-height: 40px;\n  }\n\n    .golden-capsule-three-col .capsule-img{\n      display:none;\n    }\n      .golden-capsule-three-col .capsule-img.active{\n      display:block;\n    }\n\n\n\n  .product_tab_sec .desc-tab {\n      position: relative;\n  }\n\n  .product_tab_sec .desc-tab::before {\n      content: '';\n      background-image: url('https://cdn.shopify.com/s/files/1/0039/5427/8515/files/Group_33837.png?v=1715339079');\n      position: absolute;\n         left: -87px;\n      display: block;\n      top: 50%;\n      transform: translateY(-50%);\n      background-repeat: no-repeat;\n      height: 159px;\n         width: 77px;\n      background-size: 100% 100%;\n  }\n\n    .product_tab_sec .item-headings img{\n          max-width: 30px;\n    }\n\n\n    .golden-capsule-three-col {\n          gap: 25px;\n\n  }\n  .product_tab_sec{\n    padding: 40px 20px;\n  }\n  .product_tab_sec .inner-container{\n         gap: 0px;\n  }\n  .product_tab_sec .header-text{\n      color: #2B2B2B;\n      text-align: center;\n      font-size: 56px;\n      font-style: normal;\n      font-weight: 700;\n      line-height: 58px;\n  }\n  .product_tab_sec p{\n    color: var(--color-BLACK, #000);\n  text-align: center;\n  font-size: 18px;\n  font-style: normal;\n  font-weight: 400;\n  line-height: normal;\n      text-align: center;\n  }\n  .product_tab_sec .capsule-img img{\n   max-width: 463px;\n  width: 100%;\n  }\n  .product_tab_sec .item-headings {\n      display: flex;\n      flex-direction: column;\n      gap: 40px;\n  }\n    .product_tab_sec .feature_desk_heading:active{\n      color: #2B2B2B;\n    font-size: 30px;\n    font-style: normal;\n    font-weight: 800;\n    line-height: 40px;\n    }\n\n  /* .product_tab_sec .feature_desk_heading:active{\n    color: #2B2B2B;\n    /* font-size: 20px; */\n    font-style: normal;\n    font-weight: 800;\n    line-height: 40px;\n  } */\n    .product_tab_sec .item-headings .items.active img {\n      border-radius: px;\n      border: px solid var(--Grey-Blue, #203E5C);\n      background: url(<path-to-image>) lightgray -10.025px -12.75px / 144.033% 141.883% no-repeat;\n      /* width: 51px;\n      height: 51px; */\n      max-width: 50px;\n\n  }\n  .product_tab_sec .item-headings img{\n\n  }\n  .product_tab_sec .desc-tab .desc-heading{\n    color: #2B2B2B;\n  font-size: 24px;\n  font-style: normal;\n  font-weight: 700;\n  line-height: 26px; /* 108.333% */\n  }\n  .product_tab_sec .text-containerv8 p{\n    color: #2B2B2B;\n  text-align: justify;\n  font-size: 16px;\n  font-style: normal;\n  font-weight: 400;\n  line-height: normal;\n        margin-top: 10px;\n  }\n  .product_tab_sec .item-headings .items.active img{\n        max-width: 50px;\n  border-radius: px;\n  border: px solid var(--Grey-Blue, #203E5C);\n  }\n\n   .product_tab_sec .item-headings div.active span {\n        color: #2B2B2B;\n\n      font-size: 30px;\n      font-style: normal;\n      font-weight: 800;\n      line-height: 40px;\n      }\n\n    @media(min-width:768px){\n     .golden-capsule-three-col {\n      padding: 26px 0px 20px;\n\n  }\n\n  }\n\n    .product_slider {\n          padding-bottom: 40px;\n    }\n   .product_slider a {\n          margin: auto;\n      display: block;\n      max-width: 230px;\n    }\n  @media(max-width:768px){\n    .product_tab_sec .item-headings .items.active img{\n        max-width: 27px;\n        border-radius: 222px;\n        border: 3px solid var(--Grey-Blue, #203E5C);\n       \n  }\n.containerv8 {\n    width: 100%;\n    margin: 0 auto;\n}\n\n    .product_tab_sec .desc-tab .desc-heading{\n       font-size: 18px;\n      text-align: center;\n    }\n    .product_tab_sec .text-containerv8 p{\n      font-size: 14px;\n      font-style: normal;\n      line-height: normal;\n      text-align: center;\n      margin-top: 8px;\n  }\n    .product_tab_sec {\n      padding: 24px 10px;\n  }\n    .golden-capsule-three-col {\n      gap: 25px;\n          display: grid;\n      grid-template-columns: repeat(2, 1fr);\n  }\n\n    .product_tab_sec .item-headings div span{\n       font-size: 14px;\n      font-style: normal;\n      font-weight: 700;\n      line-height: normal;\n  }\n     .product_tab_sec .item-headings div.active span {\n        color: #2B2B2B;\n      font-size: 14px;\n      font-style: normal;\n      font-weight: 800;\n      line-height: normal;\n      }\n  }\n  @media screen and (min-width:768px) {\n      .feature_mob_heading {\n          display: none;\n      }\n  }\n\n  @media screen and (max-width:767px) {\n\n      .product_tab_sec .inner-containerv8 {\n          gap: 2px;\n      }\n\n      .product_tab_sec .header-text {\n        font-size: 24px;\n        line-height: normal;\n         font-style: normal;\n        font-weight: 700;\n            word-spacing: unset;\n      }\n\n     .product_tab_sec p{\n        font-size: 14px;\n        font-style: normal;\n        font-weight: 400;\n        line-height: normal;\n      }\n\n      .golden-capsule-three-col {\n          flex-wrap: wrap;\n      }\n      .product_tab_sec .item-headings {\n          gap: 16px;\n      }\n\n      .golden-capsule-three-col .text-container {\n          flex: 100%;\n          padding-left: 0px;\n          margin-top: 80px;\n          grid-column: span 2;\n      }\n\n      .product_tab_sec .desc-tab::before {\n        background-image: url('https://cdn.shopify.com/s/files/1/0039/5427/8515/files/Group_33837.png?v=1715339079');\n          top: -220px;\n          left: 50%;\n          height: 350px;\n          width: 40px;\n          transform: translateX(-50%) rotate(90deg);\n      }\n\n      .product_tab_sec .desc-tab .desc-para {\n          font-size: 14px;\n      }\n    .product_tab_sec video{\n                 max-width: 202px;\n          min-height: 313px;\n    }\n  }\n @media(min-width:1400px){\n.containerv8 {\n    width: 75%;\n    margin: 0 auto;\n}\n</style>\n\n<script>\n  var itemHeadings = document.querySelectorAll('.golden-capsule-three-col .item-headings>div');\n  var textContainers = document.querySelectorAll('.golden-capsule-three-col .text-container div.desc-tab');\n  var imgContainers = document.querySelectorAll('.golden-capsule-three-col .img_container .capsule-img');\n\n  itemHeadings.forEach((heading, index) => {\n    heading.addEventListener('click', () => {\n      itemHeadings.forEach((item) => item.classList.remove('active'));\n      textContainers.forEach((item) => item.classList.remove('active'));\n      imgContainers.forEach((item) => item.classList.remove('active'));\n\n      heading.classList.add('active');\n      imgContainers[index].classList.add('active');\n      textContainers[index].classList.add('active');\n    });\n  });\n</script>",

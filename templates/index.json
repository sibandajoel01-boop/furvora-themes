      "settings": {
        "custom_liquid": "<style>\n  .furvora-bar {\n    width: 100%;\n    padding: 11px 20px;\n    background-color: #2F5D50;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 32px;\n    flex-wrap: wrap;\n  }\n  .furvora-bar-item {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    color: #F6F2EA;\n    font-family: 'Inter', sans-serif;\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n  .furvora-bar-dot {\n    width: 4px;\n    height: 4px;\n    border-radius: 50%;\n    background-color: rgba(246, 242, 234, 0.4);\n    display: inline-block;\n  }\n  @media (max-width: 600px) {\n    .furvora-bar { gap: 16px; padding: 10px 16px; }\n    .furvora-bar-item { font-size: 11px; }\n    .furvora-bar-item:nth-child(n+4) { display: none; }\n    .furvora-bar-dot:nth-child(n+4) { display: none; }\n  }\n</style>\n<div class=\"furvora-bar\">\n  <span class=\"furvora-bar-item\">Free Express Delivery</span>\n  <span class=\"furvora-bar-dot\"></span>\n  <span class=\"furvora-bar-item\">10% Off Your First Order \u2014 WELCOME10</span>\n  <span class=\"furvora-bar-dot\"></span>\n  <span class=\"furvora-bar-item\">30 Day Easy Returns</span>\n  <span class=\"furvora-bar-dot\"></span>\n  <span class=\"furvora-bar-item\">Secure Checkout</span>\n</div>",

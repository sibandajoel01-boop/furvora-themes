    "custom_liquid_XyydaX": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<!-- 1) STYLES: hero + nav stacking + menu-active overrides + force-white text -->\n<style>\n  /* \ud83c\udf1f Load Google Fonts */\n  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@700&family=Quicksand:wght@400;500&display=swap');\n\n  /* --- HERO STYLES --- */\n  .hero-video-container {\n    position: relative;\n    width: 100%;\n    height: 60vh;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 1;\n  }\n  .hero-video {\n    position: absolute;\n    top: 50%; left: 50%;\n    transform: translate(-50%, -50%);\n    width: 100vw; height: 100%;\n    object-fit: cover;\n    z-index: 1;\n  }\n  .hero-video-overlay {\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%; height: 100%;\n    background: rgba(0,0,0,0.5);\n    z-index: 2;\n  }\n  .hero-text {\n    position: absolute;\n    z-index: 3;\n    text-align: center;\n    padding: 20px;\n    pointer-events: auto;\n  }\n  /* \ud83c\udfa8 Force white text */\n  .hero-text h1,\n  .hero-text p {\n    color: #F9F5F0 !important;\n    text-shadow: 2px 2px 10px rgba(0,0,0,0.5);\n  }\n  .hero-text h1 {\n    font-family: 'Poppins', sans-serif;\n    font-size: 4rem;\n    font-weight: 700;\n    margin: 0;\n  }\n  .hero-text p {\n    font-family: 'Quicksand', sans-serif;\n    font-size: 1.5rem;\n    font-weight: 500;\n    margin: 10px auto 0;\n    max-width: 600px;\n    line-height: 1.4;\n  }\n  .hero-button {\n    display: inline-block;\n    background-color: #F9F5F0;\n    color: #333;\n    padding: 12px 24px;\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.5rem;\n    font-weight: 600;\n    text-decoration: none;\n    border: none;\n    border-radius: 6px;\n    margin-top: 20px;\n    transition: background .3s, transform .2s;\n    cursor: pointer;\n    pointer-events: auto;\n  }\n  .hero-button:hover {\n    background-color: #e5dfd9;\n    transform: scale(1.05);\n  }\n\n  /* \ud83d\udcf1 Mobile tweaks */\n  @media (max-width: 768px) {\n    .hero-video-container { height: 40vh; }\n    .hero-text h1 { font-size: 2.5rem; }\n    .hero-text p   { font-size: 1.2rem; max-width: 80%; }\n    .hero-button   { font-size: 1.2rem; padding: 10px 20px; }\n  }\n\n  /* --- NAV + MENU STACKING --- */\n  /* ensure your header/nav always sits above the hero */\n  .site-header,\n  .header-wrapper,\n  nav,\n  .mobile-nav,\n  .hamburger-menu {\n    position: relative;\n    z-index: 1000;\n  }\n\n  /* --- MENU\u2010ACTIVE OVERRIDES --- */\n  /* when menu is open, push hero behind and disable clicks on it */\n  .menu-active .hero-video-container {\n    z-index: 0 !important;\n    pointer-events: none !important;\n  }\n</style>\n\n<!-- 2) HERO MARKUP -->\n<div class=\"hero-video-container\">\n  <video class=\"hero-video\" autoplay muted loop playsinline>\n    <source src=\"https://cdn.shopify.com/videos/c/o/v/033574bc2a0249ba99f1ca818c6a0687.mp4\" type=\"video/mp4\">\n    Your browser does not support the video tag.\n  </video>\n  <div class=\"hero-video-overlay\"></div>\n  <div class=\"hero-text\">\n    <h1>Happiness Starts with the Right Care</h1>\n    <p>\n      Because your pet deserves the best comfort, safety, and joy\u2014every single day.\n    </p>\n    <a href=\"/collections/all\" class=\"hero-button\">Shop Pet Essentials Now</a>\n  </div>\n</div>\n\n<!-- 3) JS: toggle body.menu-active on hamburger click -->\n<script>\n  (function(){\n    var btn = document.querySelector('.hamburger-menu');\n    if (!btn) return;\n    btn.addEventListener('click', function(){\n      document.body.classList.toggle('menu-active');\n    });\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }

        "heading_8kJin6": {
          "type": "heading",
          "settings": {
            "heading": "Why We Started Furvora",
            "heading_size": "h1"
          }
        },
        "text_Kxcdrg": {
          "type": "text",
          "settings": {
            "text": "<p>At Furvora, we believe pets deserve comfort, safety, and joy in every moment. Our products are thoughtfully designed to bring quality, simplicity, and happiness into everyday life \u2014 for pets and the families who love them.</p><p>We started Furvora because we were tired of choosing between products that looked good and products that actually worked. We wanted both. So we built a brand that delivers on every level.</p>"
          }
        }
      },

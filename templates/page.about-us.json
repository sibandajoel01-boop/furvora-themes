        "heading_9gLF7x": {
          "type": "heading",
          "settings": {
            "heading": "Meet Giorgio, Our Founder",
            "heading_size": "h1"
          }
        },
        "text_cziM3F": {
          "type": "text",
          "settings": {
            "text": "<p>Giorgio started Furvora after years of searching for pet products that felt as thoughtful as they looked. Frustrated by generic options that prioritised aesthetics over comfort and safety, he set out to create something better.</p><p>Today, Furvora is built on one simple idea \u2014 every product we make should genuinely improve life for pets and their owners. No compromises.</p>",
            "text_style": "body"
          }
        },

<!-- ============================================================
     FURVORA PET ASSISTANT — Phase 1
     Save as: snippets/furvora-pet-assistant.liquid
     Then add to theme.liquid before </body>:
     {% render 'furvora-pet-assistant' %}
     ============================================================ -->

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');

  :root {
    --fpa-green:      #2F5D50;
    --fpa-green-dark: #1F3D36;
    --fpa-cream:      #F7F4EF;
    --fpa-sand:       #EDE8DF;
    --fpa-text:       #2B2B2B;
    --fpa-text-soft:  #7A6E64;
    --fpa-white:      #FFFFFF;
    --fpa-gold:       #D4A843;
    --fpa-radius:     20px;
    --fpa-shadow:     0 20px 60px rgba(0,0,0,0.15), 0 4px 16px rgba(0,0,0,0.08);
  }

  #fpa-trigger {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 58px;
    height: 58px;
    background: var(--fpa-green-dark);
    border-radius: 50%;
    border: none;
    cursor: pointer;
    z-index: 9998;
    box-shadow: 0 4px 20px rgba(31,61,54,0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 240ms cubic-bezier(0.34,1.56,0.64,1), box-shadow 240ms ease;
    outline: none;
  }
  #fpa-trigger:hover { transform: scale(1.1) translateY(-2px); box-shadow: 0 8px 28px rgba(31,61,54,0.55); }
  #fpa-trigger svg { width: 26px; height: 26px; fill: #fff; }

  #fpa-tooltip {
    position: fixed;
    bottom: 36px;
    right: 96px;
    background: var(--fpa-green-dark);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 20px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateX(8px);
    transition: opacity 200ms ease, transform 200ms ease;
    z-index: 9997;
  }
  #fpa-tooltip::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    border: 6px solid transparent;
    border-right: none;
    border-left-color: var(--fpa-green-dark);
  }
  #fpa-trigger:hover + #fpa-tooltip { opacity: 1; transform: translateX(0); }

  #fpa-widget {
    position: fixed;
    bottom: 100px;
    right: 28px;
    width: 380px;
    max-height: 580px;
    background: var(--fpa-cream);
    border-radius: var(--fpa-radius);
    box-shadow: var(--fpa-shadow);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px) scale(0.97);
    pointer-events: none;
    transition: opacity 300ms cubic-bezier(0.34,1.2,0.64,1), transform 300ms cubic-bezier(0.34,1.2,0.64,1);
    font-family: 'Inter', sans-serif;
  }
  #fpa-widget.fpa-open { opacity: 1; transform: translateY(0) scale(1); pointer-events: all; }

  .fpa-header { background: var(--fpa-green-dark); padding: 20px 22px 18px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
  .fpa-header-left { display: flex; align-items: center; gap: 12px; }
  .fpa-header-icon { width: 38px; height: 38px; background: rgba(255,255,255,0.12); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .fpa-header-icon svg { width: 20px; height: 20px; fill: #fff; }
  .fpa-header-title { font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 700; color: #fff; letter-spacing: -0.01em; line-height: 1.2; }
  .fpa-header-sub { font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 2px; font-weight: 300; }
  .fpa-close { background: rgba(255,255,255,0.1); border: none; border-radius: 50%; width: 30px; height: 30px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.7); transition: background 200ms ease; flex-shrink: 0; }
  .fpa-close:hover { background: rgba(255,255,255,0.2); color: #fff; }
  .fpa-close svg { width: 14px; height: 14px; }

  .fpa-body { flex: 1; overflow-y: auto; padding: 20px 18px; display: flex; flex-direction: column; gap: 14px; scroll-behavior: smooth; }
  .fpa-body::-webkit-scrollbar { width: 4px; }
  .fpa-body::-webkit-scrollbar-thumb { background: rgba(47,93,80,0.2); border-radius: 4px; }

  .fpa-msg { display: flex; align-items: flex-end; gap: 8px; opacity: 0; transform: translateY(8px); animation: fpa-msg-in 320ms cubic-bezier(0.34,1.2,0.64,1) forwards; }
  @keyframes fpa-msg-in { to { opacity: 1; transform: translateY(0); } }
  .fpa-msg-avatar { width: 28px; height: 28px; background: var(--fpa-green); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .fpa-msg-avatar svg { width: 14px; height: 14px; fill: #fff; }
  .fpa-bubble { background: #fff; border-radius: 16px 16px 16px 4px; padding: 11px 15px; font-size: 13.5px; color: var(--fpa-text); line-height: 1.55; max-width: 82%; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
  .fpa-bubble strong { color: var(--fpa-green); font-weight: 600; }
  .fpa-typing .fpa-bubble { padding: 13px 18px; display: flex; gap: 4px; align-items: center; }
  .fpa-dot { width: 6px; height: 6px; background: var(--fpa-text-soft); border-radius: 50%; animation: fpa-bounce 1.2s ease-in-out infinite; }
  .fpa-dot:nth-child(2) { animation-delay: 0.15s; }
  .fpa-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes fpa-bounce { 0%,60%,100% { transform: translateY(0); } 30% { transform: translateY(-5px); } }

  .fpa-input-area { padding: 14px 18px 18px; flex-shrink: 0; border-top: 1px solid rgba(47,93,80,0.08); background: var(--fpa-cream); }
  .fpa-text-row { display: flex; gap: 8px; align-items: center; }
  .fpa-text-input { flex: 1; background: #fff; border: 1.5px solid rgba(47,93,80,0.15); border-radius: 24px; padding: 10px 16px; font-family: 'Inter', sans-serif; font-size: 13px; color: var(--fpa-text); outline: none; transition: border-color 200ms ease; }
  .fpa-text-input:focus { border-color: var(--fpa-green); }
  .fpa-text-input::placeholder { color: rgba(43,43,43,0.35); }
  .fpa-send { width: 38px; height: 38px; background: var(--fpa-green); border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 200ms ease, transform 200ms ease; flex-shrink: 0; }
  .fpa-send:hover { background: var(--fpa-green-dark); transform: scale(1.05); }
  .fpa-send svg { width: 16px; height: 16px; fill: #fff; margin-left: 1px; }

  .fpa-btn-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .fpa-btn { background: #fff; border: 1.5px solid rgba(47,93,80,0.2); border-radius: 24px; padding: 8px 16px; font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 500; color: var(--fpa-text); cursor: pointer; transition: all 200ms ease; white-space: nowrap; }
  .fpa-btn:hover { background: var(--fpa-green); border-color: var(--fpa-green); color: #fff; transform: translateY(-1px); }

  .fpa-date-row { display: flex; gap: 8px; align-items: center; }
  .fpa-date-input { flex: 1; background: #fff; border: 1.5px solid rgba(47,93,80,0.15); border-radius: 24px; padding: 10px 16px; font-family: 'Inter', sans-serif; font-size: 13px; color: var(--fpa-text); outline: none; transition: border-color 200ms ease; }
  .fpa-date-input:focus { border-color: var(--fpa-green); }
  .fpa-date-confirm { background: var(--fpa-green); border: none; border-radius: 24px; padding: 10px 18px; font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; color: #fff; cursor: pointer; transition: background 200ms ease; white-space: nowrap; }
  .fpa-date-confirm:hover { background: var(--fpa-green-dark); }

  .fpa-product-card { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.08); width: 100%; animation: fpa-msg-in 320ms cubic-bezier(0.34,1.2,0.64,1) forwards; opacity: 0; }
  .fpa-product-img { width: 100%; height: 140px; background: var(--fpa-sand); display: flex; align-items: center; justify-content: center; font-size: 48px; }
  .fpa-product-body { padding: 14px 16px 16px; }
  .fpa-product-tag { font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fpa-green); margin-bottom: 6px; }
  .fpa-product-name { font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 700; color: var(--fpa-text); margin-bottom: 6px; line-height: 1.3; }
  .fpa-product-desc { font-size: 12px; color: var(--fpa-text-soft); line-height: 1.55; margin-bottom: 12px; }
  .fpa-product-cta { display: block; background: var(--fpa-green); color: #fff; text-align: center; padding: 10px 20px; border-radius: 8px; font-size: 12.5px; font-weight: 600; text-decoration: none; transition: background 200ms ease; letter-spacing: 0.03em; }
  .fpa-product-cta:hover { background: var(--fpa-green-dark); color: #fff; }

  .fpa-reward { background: linear-gradient(135deg, #1F3D36 0%, #2F5D50 100%); border-radius: 12px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; animation: fpa-msg-in 320ms cubic-bezier(0.34,1.2,0.64,1) forwards; opacity: 0; }
  .fpa-reward-icon { font-size: 24px; flex-shrink: 0; }
  .fpa-reward-title { font-size: 12px; font-weight: 700; color: #fff; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 2px; }
  .fpa-reward-desc { font-size: 11.5px; color: rgba(255,255,255,0.7); line-height: 1.4; }

  .fpa-save-card { background: var(--fpa-sand); border-radius: 12px; padding: 16px; animation: fpa-msg-in 320ms cubic-bezier(0.34,1.2,0.64,1) forwards; opacity: 0; }
  .fpa-save-text { font-size: 13px; color: var(--fpa-text); line-height: 1.55; margin-bottom: 12px; }
  .fpa-save-btns { display: flex; gap: 8px; }
  .fpa-save-yes { flex: 1; background: var(--fpa-green); border: none; border-radius: 8px; padding: 9px 14px; font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; color: #fff; cursor: pointer; transition: background 200ms ease; }
  .fpa-save-yes:hover { background: var(--fpa-green-dark); }
  .fpa-save-no { flex: 1; background: transparent; border: 1.5px solid rgba(47,93,80,0.2); border-radius: 8px; padding: 9px 14px; font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 500; color: var(--fpa-text-soft); cursor: pointer; transition: all 200ms ease; }
  .fpa-save-no:hover { border-color: var(--fpa-green); color: var(--fpa-text); }

  .fpa-welcome-back { background: linear-gradient(135deg, #1F3D36, #2F5D50); border-radius: 14px; padding: 18px; text-align: center; animation: fpa-msg-in 320ms cubic-bezier(0.34,1.2,0.64,1) forwards; opacity: 0; }
  .fpa-wb-emoji { font-size: 32px; margin-bottom: 8px; }
  .fpa-wb-title { font-family: 'Playfair Display', serif; font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 4px; }
  .fpa-wb-sub { font-size: 12px; color: rgba(255,255,255,0.65); }

  .fpa-birthday-banner { background: linear-gradient(135deg, #D4A843, #E8C060); border-radius: 12px; padding: 14px 16px; text-align: center; animation: fpa-msg-in 320ms cubic-bezier(0.34,1.2,0.64,1) forwards; opacity: 0; }
  .fpa-bday-emoji { font-size: 28px; margin-bottom: 6px; }
  .fpa-bday-title { font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 700; color: #1F3D36; margin-bottom: 4px; }
  .fpa-bday-sub { font-size: 11.5px; color: rgba(31,61,54,0.75); line-height: 1.45; margin-bottom: 10px; }
  .fpa-bday-btn { display: inline-block; background: #1F3D36; color: #fff; padding: 8px 18px; border-radius: 20px; font-size: 12px; font-weight: 600; text-decoration: none; transition: background 200ms ease; }
  .fpa-bday-btn:hover { background: #2F5D50; color: #fff; }

  @media (max-width: 480px) {
    #fpa-widget { width: calc(100vw - 24px); right: 12px; bottom: 90px; max-height: 70vh; }
    #fpa-trigger { bottom: 20px; right: 20px; }
  }
</style>

<button id="fpa-trigger" aria-label="Open Furvora Pet Assistant">
  <svg viewBox="0 0 24 24"><path d="M8.5 3C7.1 3 6 4.1 6 5.5S7.1 8 8.5 8 11 6.9 11 5.5 9.9 3 8.5 3zm7 0C14.1 3 13 4.1 13 5.5S14.1 8 15.5 8 18 6.9 18 5.5 16.9 3 15.5 3zM5 8.5C3.6 8.5 2.5 9.6 2.5 11S3.6 13.5 5 13.5 7.5 12.4 7.5 11 6.4 8.5 5 8.5zm14 0c-1.4 0-2.5 1.1-2.5 2.5s1.1 2.5 2.5 2.5 2.5-1.1 2.5-2.5-1.1-2.5-2.5-2.5zm-7 1c-3.9 0-7 2.2-7 5.5 0 3 2.8 5 7 5s7-2 7-5c0-3.3-3.1-5.5-7-5.5z"/></svg>
</button>
<div id="fpa-tooltip">Find the perfect product for your pet</div>

<div id="fpa-widget" role="dialog" aria-label="Furvora Pet Assistant">
  <div class="fpa-header">
    <div class="fpa-header-left">
      <div class="fpa-header-icon">
        <svg viewBox="0 0 24 24"><path d="M8.5 3C7.1 3 6 4.1 6 5.5S7.1 8 8.5 8 11 6.9 11 5.5 9.9 3 8.5 3zm7 0C14.1 3 13 4.1 13 5.5S14.1 8 15.5 8 18 6.9 18 5.5 16.9 3 15.5 3zM5 8.5C3.6 8.5 2.5 9.6 2.5 11S3.6 13.5 5 13.5 7.5 12.4 7.5 11 6.4 8.5 5 8.5zm14 0c-1.4 0-2.5 1.1-2.5 2.5s1.1 2.5 2.5 2.5 2.5-1.1 2.5-2.5-1.1-2.5-2.5-2.5zm-7 1c-3.9 0-7 2.2-7 5.5 0 3 2.8 5 7 5s7-2 7-5c0-3.3-3.1-5.5-7-5.5z"/></svg>
      </div>
      <div>
        <div class="fpa-header-title">Furvora Pet Assistant</div>
        <div class="fpa-header-sub">Let me help you find the perfect product</div>
      </div>
    </div>
    <button class="fpa-close" id="fpa-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="fpa-body" id="fpa-body"></div>
  <div class="fpa-input-area" id="fpa-input-area"></div>
</div>

<script>
(function() {
  const trigger = document.getElementById('fpa-trigger');
  const widget  = document.getElementById('fpa-widget');
  const closeBtn = document.getElementById('fpa-close');
  const body    = document.getElementById('fpa-body');
  const inputArea = document.getElementById('fpa-input-area');
  const PAW_SVG = '<svg viewBox="0 0 24 24"><path d="M8.5 3C7.1 3 6 4.1 6 5.5S7.1 8 8.5 8 11 6.9 11 5.5 9.9 3 8.5 3zm7 0C14.1 3 13 4.1 13 5.5S14.1 8 15.5 8 18 6.9 18 5.5 16.9 3 15.5 3zM5 8.5C3.6 8.5 2.5 9.6 2.5 11S3.6 13.5 5 13.5 7.5 12.4 7.5 11 6.4 8.5 5 8.5zm14 0c-1.4 0-2.5 1.1-2.5 2.5s1.1 2.5 2.5 2.5 2.5-1.1 2.5-2.5-1.1-2.5-2.5-2.5zm-7 1c-3.9 0-7 2.2-7 5.5 0 3 2.8 5 7 5s7-2 7-5c0-3.3-3.1-5.5-7-5.5z"/></svg>';

  let profile = {};
  let isOpen = false;
  let started = false;

  const products = {
    'Sleeping and relaxing': { name: 'Soft Plush Pet Bed', desc: 'Ultra-soft calming materials for deep, restful sleep. Your pet will never want to leave.', url: '/products/soft-plush-pet-bed', emoji: '🛏️' },
    'Playing and chasing':   { name: 'Cat Toy Feather Ball', desc: 'Irresistible motion that triggers natural play instincts. Hours of healthy entertainment.', url: '/products/cat-toy-feather-ball', emoji: '🎾' },
    'Exploring outdoors':    { name: 'Anti Slip Dog Shoes', desc: 'Protective paw boots for every adventure. Grip, comfort and durability for active pets.', url: '/products/anti-slip-dog-shoes', emoji: '🥾' },
    'Cuddling and comfort':  { name: 'Long Plush Cat Bed', desc: 'Deeply plush comfort designed for pets who live for warmth and closeness.', url: '/products/long-plush-cat-bed', emoji: '🤗' }
  };

  trigger.addEventListener('click', () => {
    isOpen = !isOpen;
    widget.classList.toggle('fpa-open', isOpen);
    if (isOpen && !started) { started = true; startConversation(); }
  });
  closeBtn.addEventListener('click', () => { isOpen = false; widget.classList.remove('fpa-open'); });

  function scrollBottom() { setTimeout(() => { body.scrollTop = body.scrollHeight; }, 50); }

  function addMessage(html, delay = 0) {
    return new Promise(resolve => {
      setTimeout(() => {
        const msg = document.createElement('div');
        msg.className = 'fpa-msg';
        msg.innerHTML = `<div class="fpa-msg-avatar">${PAW_SVG}</div><div class="fpa-bubble">${html}</div>`;
        body.appendChild(msg);
        scrollBottom();
        resolve();
      }, delay);
    });
  }

  function addUserMsg(text) {
    const msg = document.createElement('div');
    msg.className = 'fpa-msg';
    msg.style.flexDirection = 'row-reverse';
    msg.innerHTML = `<div class="fpa-bubble" style="background:var(--fpa-green);color:#fff;border-radius:16px 16px 4px 16px;">${text}</div>`;
    body.appendChild(msg);
    scrollBottom();
  }

  function showTyping() {
    return new Promise(resolve => {
      const t = document.createElement('div');
      t.className = 'fpa-msg fpa-typing';
      t.id = 'fpa-typing-ind';
      t.innerHTML = `<div class="fpa-msg-avatar">${PAW_SVG}</div><div class="fpa-bubble"><div class="fpa-dot"></div><div class="fpa-dot"></div><div class="fpa-dot"></div></div>`;
      body.appendChild(t);
      scrollBottom();
      setTimeout(() => { const el = document.getElementById('fpa-typing-ind'); if (el) el.remove(); resolve(); }, 900);
    });
  }

  function clearInput() { inputArea.innerHTML = ''; }

  function showTextInput(placeholder, cb) {
    clearInput();
    inputArea.innerHTML = `<div class="fpa-text-row"><input class="fpa-text-input" type="text" placeholder="${placeholder}" id="fpa-tf" autocomplete="off"><button class="fpa-send" id="fpa-sb"><svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/></svg></button></div>`;
    const inp = document.getElementById('fpa-tf');
    inp.focus();
    const go = () => { const v = inp.value.trim(); if (!v) return; clearInput(); cb(v); };
    document.getElementById('fpa-sb').addEventListener('click', go);
    inp.addEventListener('keydown', e => { if (e.key === 'Enter') go(); });
  }

  function showButtons(opts, cb) {
    clearInput();
    const g = document.createElement('div');
    g.className = 'fpa-btn-grid';
    opts.forEach(o => {
      const b = document.createElement('button');
      b.className = 'fpa-btn';
      b.textContent = o;
      b.addEventListener('click', () => { clearInput(); cb(o); });
      g.appendChild(b);
    });
    inputArea.appendChild(g);
  }

  function showDateInput(cb) {
    clearInput();
    inputArea.innerHTML = `<div class="fpa-date-row"><input class="fpa-date-input" type="date" id="fpa-df"><button class="fpa-date-confirm" id="fpa-dc">Confirm</button></div>`;
    document.getElementById('fpa-dc').addEventListener('click', () => {
      const v = document.getElementById('fpa-df').value;
      if (!v) return;
      clearInput(); cb(v);
    });
  }

  function isBirthdayWeek(str) {
    if (!str) return false;
    const t = new Date(), b = new Date(str);
    const y = new Date(t.getFullYear(), b.getMonth(), b.getDate());
    return Math.abs(t - y) / 86400000 <= 7;
  }

  async function startConversation() {
    const saved = localStorage.getItem('furvora_pet_profile');
    if (saved) { profile = JSON.parse(saved); await showReturningVisitor(); return; }
    await showTyping();
    await addMessage('Hey there! 👋 I\'m your <strong>Furvora Pet Assistant</strong>. I\'ll help you find the perfect product for your furry friend.');
    await showTyping();
    await addMessage('Let\'s start with something fun. What\'s your pet\'s name?');
    showTextInput("Enter your pet's name...", async v => { profile.pet_name = v; addUserMsg(v); await askType(); });
  }

  async function askType() {
    await showTyping();
    await addMessage(`What a wonderful name! 🐾 What type of pet is <strong>${profile.pet_name}</strong>?`);
    showButtons(['Dog 🐶', 'Cat 🐱'], async v => { profile.pet_type = v; addUserMsg(v); await askAge(); });
  }

  async function askAge() {
    await showTyping();
    await addMessage(`How old is <strong>${profile.pet_name}</strong>?`);
    showButtons(['Under 1 year', '1 to 3 years', '4 to 7 years', '8 years or older'], async v => { profile.pet_age = v; addUserMsg(v); await askColor(); });
  }

  async function askColor() {
    await showTyping();
    await addMessage(`What colour is <strong>${profile.pet_name}</strong>?`);
    showButtons(['Black', 'White', 'Brown', 'Golden', 'Mixed'], async v => { profile.pet_color = v; addUserMsg(v); await askBirthday(); });
  }

  async function askBirthday() {
    await showTyping();
    await addMessage(`When is <strong>${profile.pet_name}</strong>'s birthday? 🎂 We'll make sure they feel special on their big day.`);
    showDateInput(async v => {
      profile.pet_birthday = v;
      addUserMsg(new Date(v).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }));
      await askPreference();
    });
  }

  async function askPreference() {
    await showTyping();
    await addMessage(`Almost done! What does <strong>${profile.pet_name}</strong> enjoy the most?`);
    showButtons(['Sleeping and relaxing', 'Playing and chasing', 'Exploring outdoors', 'Cuddling and comfort'], async v => {
      profile.pet_preference = v; addUserMsg(v); clearInput(); await showRecommendation();
    });
  }

  async function showRecommendation() {
    await showTyping();
    await addMessage(`Based on what you told me about <strong>${profile.pet_name}</strong>, I found something they will absolutely love. 🎯`);
    const p = products[profile.pet_preference] || products['Cuddling and comfort'];
    setTimeout(() => {
      const c = document.createElement('div');
      c.className = 'fpa-product-card';
      c.innerHTML = `<div class="fpa-product-img">${p.emoji}</div><div class="fpa-product-body"><div class="fpa-product-tag">Recommended for ${profile.pet_name}</div><div class="fpa-product-name">${p.name}</div><div class="fpa-product-desc">${p.desc}</div><a href="${p.url}" class="fpa-product-cta">View Recommendation →</a></div>`;
      body.appendChild(c); scrollBottom();
    }, 400);
    setTimeout(() => {
      const r = document.createElement('div');
      r.className = 'fpa-reward';
      r.innerHTML = `<div class="fpa-reward-icon">🎁</div><div><div class="fpa-reward-title">You unlocked Free Shipping</div><div class="fpa-reward-desc">Because you completed the Furvora Pet Assistant, you get free shipping on your next order today.</div></div>`;
      body.appendChild(r); scrollBottom();
    }, 800);
    setTimeout(async () => { await showTyping(); await showSaveProfile(); }, 1400);
  }

  async function showSaveProfile() {
    const c = document.createElement('div');
    c.className = 'fpa-save-card';
    c.innerHTML = `<div class="fpa-save-text">Would you like us to remember <strong>${profile.pet_name}</strong> so we can recommend products and surprises tailored just for them?</div><div class="fpa-save-btns"><button class="fpa-save-yes" id="fpa-sy">Save ${profile.pet_name}'s Profile 🐾</button><button class="fpa-save-no" id="fpa-sn">Maybe Later</button></div>`;
    body.appendChild(c); scrollBottom();
    document.getElementById('fpa-sy').addEventListener('click', async () => {
      localStorage.setItem('furvora_pet_profile', JSON.stringify(profile));
      c.remove(); addUserMsg('Save Profile');
      await showTyping();
      await addMessage(`Done! 🐾 <strong>${profile.pet_name}</strong>'s profile has been saved. We will personalise your experience every visit. See you soon!`);
      clearInput();
    });
    document.getElementById('fpa-sn').addEventListener('click', async () => {
      c.remove(); addUserMsg('Maybe Later');
      await showTyping();
      await addMessage(`No problem at all! 😊 Have a wonderful day with <strong>${profile.pet_name}</strong>!`);
      clearInput();
    });
  }

  async function showReturningVisitor() {
    if (profile.pet_birthday && isBirthdayWeek(profile.pet_birthday)) {
      const b = document.createElement('div');
      b.className = 'fpa-birthday-banner';
      b.innerHTML = `<div class="fpa-bday-emoji">🎂🎉</div><div class="fpa-bday-title">It's ${profile.pet_name}'s Birthday Week!</div><div class="fpa-bday-sub">Celebrate with a special surprise from Furvora.</div><a href="/collections/all" class="fpa-bday-btn">Celebrate ${profile.pet_name}'s Birthday 🎁</a>`;
      body.appendChild(b); scrollBottom();
    }
    const w = document.createElement('div');
    w.className = 'fpa-welcome-back';
    w.innerHTML = `<div class="fpa-wb-emoji">🐾</div><div class="fpa-wb-title">Welcome back!</div><div class="fpa-wb-sub">How is <strong style="color:#fff">${profile.pet_name}</strong> doing today?</div>`;
    body.appendChild(w); scrollBottom();
    await showTyping();
    await addMessage(`Great to see you again! Here's something <strong>${profile.pet_name}</strong> might love today.`);
    const p = products[profile.pet_preference] || products['Cuddling and comfort'];
    setTimeout(() => {
      const c = document.createElement('div');
      c.className = 'fpa-product-card';
      c.innerHTML = `<div class="fpa-product-img">${p.emoji}</div><div class="fpa-product-body"><div class="fpa-product-tag">Picked for ${profile.pet_name}</div><div class="fpa-product-name">${p.name}</div><div class="fpa-product-desc">${p.desc}</div><a href="${p.url}" class="fpa-product-cta">Shop Now →</a></div>`;
      body.appendChild(c); scrollBottom();
    }, 400);
    setTimeout(() => {
      const r = document.createElement('div');
      r.style.cssText = 'text-align:center;padding:8px 0;';
      r.innerHTML = `<button style="background:none;border:none;font-size:11px;color:var(--fpa-text-soft);cursor:pointer;text-decoration:underline;font-family:Inter,sans-serif;" id="fpa-reset">Not ${profile.pet_name}? Start fresh</button>`;
      body.appendChild(r);
      document.getElementById('fpa-reset').addEventListener('click', () => {
        localStorage.removeItem('furvora_pet_profile');
        profile = {}; started = false; body.innerHTML = ''; clearInput(); startConversation();
      });
      scrollBottom();
    }, 800);
  }
})();
</script>
